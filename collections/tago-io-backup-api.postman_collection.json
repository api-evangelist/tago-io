        {
          "id": "1120a6a1-f3eb-4bbf-ad6e-76386b4b3e40",
          "name": "List Backups",
          "request": {
            "name": "List Backups",
            "description": {
              "content": "Retrieves a paginated list of all backups for the specified profile. Use this endpoint to check backup status and find backup IDs for download or deletion.\n\n**Backup statuses:**\n- `queued` - Backup request received, waiting for processing\n- `processing` - Backup generation in progress\n- `completed` - Backup ready for download\n- `failed` - Backup generation failed (check error_message)\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "profile",
                ":profile_id",
                "backup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for pagination (default 1)"
                },
