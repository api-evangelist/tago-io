            "url": "https://api.us-e1.tago.io/device/token/:deviceID",
            "params": [
              {
                "name": "deviceID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves list of all tokens from device\n"
        },
        {
          "info": {
            "name": "Create Token",
